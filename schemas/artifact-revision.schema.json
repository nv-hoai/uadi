{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uadi.dev/schemas/artifact-revision.schema.json",
  "title": "UADI Immutable Artifact Revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision_id",
    "artifact_id",
    "artifact_type",
    "version",
    "parent_revision_id",
    "created_at",
    "content_sha256",
    "artifact"
  ],
  "properties": {
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "proposal",
        "uds",
        "design_configuration",
        "prototype"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "parent_revision_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "feedback_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        },
        "required": [
          "version"
        ]
      },
      "then": {
        "properties": {
          "parent_revision_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 2
          }
        },
        "required": [
          "version"
        ]
      },
      "then": {
        "properties": {
          "parent_revision_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
