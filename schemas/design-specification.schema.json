{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uadi.dev/schemas/design-specification.schema.json",
  "title": "UADI Design Specification (UDS)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "spec_id",
    "proposal_id",
    "version",
    "target",
    "tokens",
    "pages",
    "accessibility",
    "responsive"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "spec_id": {
      "type": "string"
    },
    "proposal_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "viewports"
      ],
      "properties": {
        "platform": {
          "type": "string"
        },
        "viewports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page_id",
          "name",
          "sections"
        ],
        "properties": {
          "page_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/section"
            }
          }
        }
      }
    },
    "responsive": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "breakpoint",
          "behavior"
        ],
        "properties": {
          "breakpoint": {
            "type": "string"
          },
          "behavior": {
            "type": "string"
          }
        }
      }
    },
    "accessibility": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement",
          "level"
        ],
        "properties": {
          "requirement": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "MUST",
              "SHOULD"
            ]
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "result"
      ],
      "properties": {
        "trigger": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "state_change": {
          "type": "string"
        },
        "keyboard_behavior": {
          "type": "string"
        }
      }
    },
    "navigationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pageShellLayout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "primaryNavigationLayout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/navigationItem"
          }
        }
      }
    },
    "alertLayout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variant": {
          "type": "string",
          "enum": [
            "info",
            "success",
            "warning",
            "error"
          ]
        }
      }
    },
    "formFieldLayout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "placeholder": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "email",
            "number",
            "search",
            "tel",
            "url"
          ]
        }
      }
    },
    "emptyStateLayout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "component_id"
      ],
      "properties": {
        "section_id": {
          "type": "string"
        },
        "component_id": {
          "type": "string",
          "enum": [
            "uadi.layout.page-shell",
            "uadi.navigation.primary",
            "uadi.feedback.alert",
            "uadi.form.field",
            "uadi.data.empty-state"
          ],
          "description": "Stable identifier from the UADI component catalog, not a framework component name."
        },
        "content_intent": {
          "type": "string"
        },
        "layout": {
          "type": "object"
        },
        "interactions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interaction"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "component_id"
            ],
            "properties": {
              "component_id": {
                "const": "uadi.layout.page-shell"
              }
            }
          },
          "then": {
            "properties": {
              "layout": {
                "$ref": "#/$defs/pageShellLayout"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "component_id"
            ],
            "properties": {
              "component_id": {
                "const": "uadi.navigation.primary"
              }
            }
          },
          "then": {
            "properties": {
              "layout": {
                "$ref": "#/$defs/primaryNavigationLayout"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "component_id"
            ],
            "properties": {
              "component_id": {
                "const": "uadi.feedback.alert"
              }
            }
          },
          "then": {
            "properties": {
              "layout": {
                "$ref": "#/$defs/alertLayout"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "component_id"
            ],
            "properties": {
              "component_id": {
                "const": "uadi.form.field"
              }
            }
          },
          "then": {
            "properties": {
              "layout": {
                "$ref": "#/$defs/formFieldLayout"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "component_id"
            ],
            "properties": {
              "component_id": {
                "const": "uadi.data.empty-state"
              }
            }
          },
          "then": {
            "properties": {
              "layout": {
                "$ref": "#/$defs/emptyStateLayout"
              }
            }
          }
        }
      ]
    }
  }
}
