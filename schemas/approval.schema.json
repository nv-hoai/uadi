{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uadi.dev/schemas/approval.schema.json",
  "title": "UADI Approval Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "proposal_id",
    "proposal_version",
    "decision",
    "actor_id",
    "actor_role",
    "timestamp",
    "authorization_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "approval_id": {
      "type": "string"
    },
    "proposal_id": {
      "type": "string"
    },
    "proposal_version": {
      "type": "integer",
      "minimum": 1
    },
    "decision": {
      "const": "APPROVE"
    },
    "actor_id": {
      "type": "string"
    },
    "actor_role": {
      "const": "OWNER"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Reference to a trusted authorization event or system identity; never treat an LLM-authored claim as proof."
    },
    "notes": {
      "type": "string"
    }
  }
}
