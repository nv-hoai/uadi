{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uadi.dev/schemas/approval-record.schema.json",
  "title": "UADI Approval Record",
  "type": "object",
  "required": ["schema_version", "approval_id", "proposal_id", "proposal_version", "decision", "approver", "approved_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "approval_id": { "type": "string" },
    "proposal_id": { "type": "string" },
    "proposal_version": { "type": "integer", "minimum": 1 },
    "decision": { "enum": ["APPROVE", "REJECT"] },
    "approver": {
      "type": "object",
      "required": ["actor_id", "role"],
      "properties": {
        "actor_id": { "type": "string" },
        "role": { "enum": ["OWNER", "AUTHORIZED_DELEGATE"] }
      },
      "additionalProperties": false
    },
    "approved_at": { "type": "string", "format": "date-time" },
    "note": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}