{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uadi.dev/schemas/quality-evidence.schema.json",
  "title": "UADI Quality Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceId", "gateId", "artifactId", "artifactVersion", "artifactSha256", "evaluator", "outcome", "observedAt", "runId", "checks"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "evidenceId": { "type": "string", "minLength": 1 },
    "gateId": { "enum": ["INPUT_CONTEXT", "REQUIREMENT_COVERAGE", "DESIGN_QUALITY", "SCHEMA_ARTIFACT", "GOVERNANCE", "PROTOTYPE_RUNTIME", "UX_ACCESSIBILITY_VISUAL", "SECURITY_SAFETY", "HUMAN_APPROVAL", "PUBLISH_REGRESSION"] },
    "artifactId": { "type": "string", "minLength": 1 },
    "artifactVersion": { "type": "integer", "minimum": 1 },
    "artifactSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "evaluator": { "type": "string", "minLength": 1 },
    "outcome": { "enum": ["PASS", "FAIL", "WARNING", "BLOCKED"] },
    "observedAt": { "type": "string", "format": "date-time" },
    "runId": { "type": "string", "minLength": 1 },
    "checks": { "type": "array", "minItems": 1 },
    "source": { "type": "string" }
  }
}
