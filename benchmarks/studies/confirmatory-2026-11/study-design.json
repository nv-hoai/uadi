    "require_reviewer_calibration": true,
    "require_held_out_suite_for_guidance_changes": true
  },
  "execution": {
    "mode": "concurrent-recorded",
    "concurrency": "6 parallel build workers; each takes one pair at a time and runs its two conditions in the preregistered order (verify per-pair baseline_run_position in mapping.json). Recorded as a protocol deviation from the preregistered sequential mode (outcome-blind; scoring unaffected). Timing is descriptive only under concurrency.",
    "time_budget_minutes": 20,
    "record_tokens": true,
    "record_cost": true
  },
